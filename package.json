{
  "name": "rn-audio-libs",
  "version": "5.0.0",
  "packageManager": "yarn@4.6.0",
  "private": true,
  "scripts": {
    "scripts:exec": "chmod +x scripts/*.sh",
    "setup:conan": "./scripts/setup_conan.sh",
    "lock:conan": "./scripts/conan_lock.sh",
    "build": "yarn run clean && yarn run build:conan && yarn run build:ffmpeg",
    "build:conan": "./scripts/conan_build.sh",
    "build:ffmpeg": "./scripts/ffmpeg_setup.sh",
    "export": "bash ./scripts/pack_outputs.sh && bash ./scripts/pack_spm_xcframeworks.sh",
    "verify": "./scripts/verify_outputs.sh",
    "bump:rn-audio-api": "python3 scripts/bump_rn_audio_api.py",
    "clean": "rm -rf outputs/* sources/* build/* 2>/dev/null || true"
  }
}
